index 0000000..ef1771f
--- /dev/null
+++ b/src/backend/fixtures/knownBugs/knownBugs.ts
@@ -0,0 +1,105 @@
+import * as fs from 'fs';
+import * as path from 'path';
+import type { TestInfo } from '@playwright/test';
+
+export type KnownBugEnv = 'dev' | 'dev2' | 'test';
+
+export interface KnownBugEntry {
+  /** Id from the test title, for example "REG-1008". */
+  case?: string;
+  /** Exact test title, for a test that has no id. */
+  title?: string;
+  /** Key of the Phoenix bug ticket. */
+  jira: string | null;
+  /** Environments where the bug is confirmed. */
+  envs: KnownBugEnv[];
+  /** Case-insensitive regular expression matched against the error text. */
+  errorPattern: string;
+  summary: string;
+  markedOn?: string;
+}
+
+/** Annotation types written to the report. The reporters read `KNOWN_BUG`. */
+export const KNOWN_BUG = 'known-bug';
+export const KNOWN_BUG_FIXED = 'known-bug-fixed';
+export const KNOWN_BUG_DRIFT = 'known-bug-drift';
+
+const REGISTRY_PATH = path.resolve(__dirname, 'known-bugs.json');
+const ANSI = /\u001b\[[0-9;]*m/g;
+
+let cachedEntries: KnownBugEntry[] | undefined;
+
+function loadEntries(): KnownBugEntry[] {
+  if (cachedEntries) return cachedEntries;
+  try {
+    const data = JSON.parse(fs.readFileSync(REGISTRY_PATH, 'utf-8'));
+    cachedEntries = Array.isArray(data?.entries) ? data.entries : [];
+  } catch (error) {
+    // A broken registry must not hide failures: with no entries every case is judged normally.
+    console.warn(`[knownBugs] Could not read ${REGISTRY_PATH}; no case is treated as a known bug.`, error);
+    cachedEntries = [];
+  }
+  return cachedEntries!;
+}
+
+export function knownBugEnv(baseURL?: string): KnownBugEnv | undefined {
+  const url = (process.env.BASE_URL || baseURL || '').toLowerCase();
+  if (url.includes('phoenix2-dev')) return 'dev2';
+  if (url.includes('phoenix1-dev')) return 'dev';
+  if (url.includes('phoenix-epres')) return 'test';
+  const named = (process.env.ENV_NAME ?? '').toLowerCase();
+  return named === 'dev' || named === 'dev2' || named === 'test' ? named : undefined;
+}
+
+export function findKnownBug(title: string, env: KnownBugEnv | undefined): KnownBugEntry | undefined {
+  if (!env) return undefined;
+  const id = title.match(/\[([A-Z][A-Z0-9]+-\d+)\]/)?.[1];
+  return loadEntries().find(entry =>
+    Array.isArray(entry.envs) && entry.envs.includes(env)
+    && ((!!entry.case && entry.case === id) || (!!entry.title && entry.title === title))
+  );
+}
+
+function matchesPattern(entry: KnownBugEntry, errorText: string): boolean {
+  try {
+    return new RegExp(entry.errorPattern, 'is').test(errorText);
+  } catch {
+    console.warn(`[knownBugs] Invalid errorPattern for ${entry.case ?? entry.title}: ${entry.errorPattern}`);
+    return false;
+  }
+}
+
+/**
+ * Runs after the test body. When the case is listed for this environment:
+ * - the listed failure is reported as an expected one, labelled `known-bug`
+ * - a different failure stays failed, labelled `known-bug-drift`
+ * - a pass fails the case, labelled `known-bug-fixed`, so the entry gets removed
+ */
+export function applyKnownBug(testInfo: TestInfo, baseURL?: string): void {
+  const entry = findKnownBug(testInfo.title, knownBugEnv(baseURL));
+  if (!entry) return;
+
+  const label = `${entry.jira ?? 'no Jira ticket yet'}: ${entry.summary}`;
+  const status = testInfo.status;
+
+  if (status === 'passed') {
+    testInfo.annotations.push({ type: KNOWN_BUG_FIXED, description: label });
+    throw new Error(
+      `Known bug no longer reproduces (${label}). ` +
+      `Remove "${entry.case ?? entry.title}" from src/backend/fixtures/knownBugs/known-bugs.json.`
+    );
+  }
+  if (status !== 'failed' && status !== 'timedOut') return;
+
+  const errorText = testInfo.errors
+    .map(error => `${error.message ?? ''}\n${error.stack ?? ''}`)
+    .join('\n')
+    .replace(ANSI, '');
+
+  if (matchesPattern(entry, errorText)) {
+    testInfo.annotations.push({ type: KNOWN_BUG, description: label });
+    testInfo.expectedStatus = status;
+  } else {
+    testInfo.annotations.push({ type: KNOWN_BUG_DRIFT, description: `${label} (failed with a different error)` });
+  }
+}
