# Allowlist. Everything is ignored unless a later rule un-ignores it.
# Files already tracked by Git stay tracked. This only stops new junk
# from showing up as untracked.

*
!*/

# Root metadata
!.gitignore
!.gitmodules

# Tooling
!.cursor/**
!.github/**
!.vscode/**

# Portable toolkit package on this branch
!QA-AI-Toolkit/**

# Project files we keep
!Cursor-Project/**/*.md
!Cursor-Project/**/*.mdc
!Cursor-Project/**/*.ps1
!Cursor-Project/**/*.py
!Cursor-Project/**/*.json
!Cursor-Project/**/*.txt
!Cursor-Project/**/*.svg
!Cursor-Project/**/*.ts
!Cursor-Project/**/*.mjs
!Cursor-Project/**/*.html
!Cursor-Project/**/*.drawio
!Cursor-Project/**/*.jsonl
!Cursor-Project/**/*.csv
!Cursor-Project/**/*.sql
!Cursor-Project/**/*.diff
!Cursor-Project/**/*.cmd
!Cursor-Project/**/*.example
!Cursor-Project/**/*.code-workspace
!Cursor-Project/**/*.docx
!Cursor-Project/**/*.yml
!Cursor-Project/**/*.yaml
!Cursor-Project/**/.gitignore
!Cursor-Project/scripts/git-hooks/commit-msg
!Cursor-Project/scripts/git-hooks/pre-commit

# Scratch, generated output, and secrets — last match wins
.cursor/logs/
**/*.log
**/*.bak
**/*.swp
**/*.swo
**/__pycache__/
**/*.py[cod]
**/*.so
**/node_modules/
**/.DS_Store
**/._*
**/Thumbs.db
**/Desktop.ini
**/.idea/
**/*.xlsx
**/out.txt
**/*-full.json
**/*-full-temp.json

Cursor-Project/config/tmp/
Cursor-Project/reports/
Cursor-Project/test_cases/
Cursor-Project/cross_dependencies/
Cursor-Project/config/jira/attachments/
Cursor-Project/config/jira/_pdt*
Cursor-Project/config/jira/tmp-*
Cursor-Project/config/confluence/_*
Cursor-Project/config/confluence/pdt*
Cursor-Project/config/confluence/pages/*-fresh.json
Cursor-Project/config/confluence/pages/*-retry.json
Cursor-Project/config/confluence/pages/pdt*.json
Cursor-Project/config/confluence/search-*.json
!Cursor-Project/config/confluence/search-confluence-rest.ps1

Cursor-Project/**/.env
Cursor-Project/**/.env.local
Cursor-Project/**/.env.*.local
