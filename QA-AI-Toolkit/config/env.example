# --- GitLab (required before clone step) ---
GITLAB_BASE_URL=
GITLAB_TOKEN=

# --- Jira (MCP preferred; REST fallback uses these) ---
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BASE_URL=

# --- Confluence (MCP preferred; REST fallback uses these) ---
CONFLUENCE_URL=
CONFLUENCE_WIKI_BASE=
