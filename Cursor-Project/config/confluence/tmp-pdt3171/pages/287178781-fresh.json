    "body":  {
                 "storage":  {
                                 "value":  "\u003ctable data-table-width=\"760\" data-layout=\"center\" ac:local-id=\"218ddd53-8093-43fe-b5b2-4a4d0068737a\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003cth data-highlight-colour=\"var(--ds-background-accent-gray-subtlest, var(--ds-background-accent-gray-subtlest, #F1F2F4))\"\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003c/th\u003e\u003cth data-highlight-colour=\"var(--ds-background-accent-gray-subtlest, var(--ds-background-accent-gray-subtlest, #F1F2F4))\"\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003c/th\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd data-highlight-colour=\"var(--ds-surface, #FFFFFF)\"\u003e\u003cp\u003e\u003cstrong\u003eNumber\u003c/strong\u003e\u003c/p\u003e\u003c/td\u003e\u003ctd data-highlight-colour=\"var(--ds-surface, #FFFFFF)\"\u003e\u003cp\u003eShould be generated automatically by the system\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eMandatory\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd data-highlight-colour=\"var(--ds-surface, #FFFFFF)\"\u003e\u003cp\u003e\u003cstrong\u003eAccounting period\u003c/strong\u003e\u003c/p\u003e\u003c/td\u003e\u003ctd data-highlight-colour=\"var(--ds-surface, #FFFFFF)\"\u003e\u003cp\u003eBy default, the current month\u0027s accounting period should be selected in this field\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eMandatory\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd data-highlight-colour=\"var(--ds-surface, #FFFFFF)\"\u003e\u003cp\u003e\u003cstrong\u003eCreation date\u003c/strong\u003e\u003c/p\u003e\u003c/td\u003e\u003ctd data-highlight-colour=\"var(--ds-surface, #FFFFFF)\"\u003e\u003cp\u003eshould be set to today\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eMandatory\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd data-highlight-colour=\"var(--d