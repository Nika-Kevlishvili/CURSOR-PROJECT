    </mxGraphModel>
  </diagram>
  <diagram id="mapping" name="Prod to Experiment map">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="Prod phase → Experiment stage" style="text;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p" value="PROD&#xa;&#xa;criteria&#xa;fill_by_volume_ri/bds&#xa;volume_holder + SLP&#xa;pulling loop&#xa;billing_data_by_profile&#xa;errors + PC&#xa;settlement prices&#xa;publish tables&#xa;compensation OFF" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="280" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="x" value="EXPERIMENT&#xa;&#xa;01&#xa;02.01–02.03&#xa;02.04–02.06&#xa;03&#xa;04–06 workers&#xa;07–10&#xa;11–13 workers&#xa;14&#xa;20 ON" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="70" width="280" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="arr" style="endArrow=block;html=1;strokeWidth=3;" edge="1" parent="1" source="p" target="x">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="n" value="Red boxes on other tabs = highest QA risk (pulling, worker COMMIT, compensation)." style="text;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="760" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
