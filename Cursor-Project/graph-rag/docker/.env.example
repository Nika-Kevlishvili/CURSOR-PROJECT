# Copy to .env and adjust. Do not commit .env.

# Neo4j
NEO4J_PASSWORD=changeme
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Shown in graph_status for clients (use host LAN IP when remote)
NEO4J_BROWSER_URL=http://localhost:7474

# Ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b
LLM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# GraphRAG MCP (SSE)
MCP_PORT=8100

# Host path mounted into the graph-rag container as /workspace (read-only).
# Windows example: D:/Cursor/cursor-project
# Linux example: /home/you/cursor-project
GRAPH_RAG_WORKSPACE_HOST=D:/Cursor/cursor-project
