{
  "name": "flaky-test-analyzer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local Playwright flaky-test analyzer and approval-gated fixer for EnergoTS reports.",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --experimental-sqlite --import tsx src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build && node --experimental-sqlite ./node_modules/esbuild/bin/esbuild src/server/index.ts --bundle --platform=node --format=esm --outfile=dist/server/index.js --packages=external --external:node:sqlite",
    "start": "node --experimental-sqlite dist/server/index.js",
    "test": "node ./scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "diff": "^7.0.0",
    "express": "^4.21.2",
    "fflate": "^0.8.2",
    "multer": "^1.4.5-lts.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
