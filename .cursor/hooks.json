{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      { "command": "powershell -ExecutionPolicy Bypass -File .cursor/hooks/block-jira-phoenix-delivery.ps1" },
      { "command": "powershell -ExecutionPolicy Bypass -File .cursor/hooks/remind-test-case-env-first.ps1" },
      { "command": "powershell -ExecutionPolicy Bypass -File .cursor/hooks/block-energots-branch-requests.ps1" }
    ],
    "afterFileEdit": [
      { "command": "powershell -ExecutionPolicy Bypass -File .cursor/hooks/protect-phoenix-code.ps1" },
      { "command": "powershell -ExecutionPolicy Bypass -File .cursor/hooks/protect-energots-writes.ps1" },
      { "command": "powershell -ExecutionPolicy Bypass -File .cursor/hooks/warn-phoenix-code-edit.ps1" }
    ],
    "beforeMCPExecution": [
      { "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/block-postgresql-mcp.ps1" },
      { "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/block-elasticsearch-mcp.ps1" },
      { "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/block-atlassian-mcp.ps1" },
      { "command": "powershell -ExecutionPolicy Bypass -File .cursor/hooks/block-confluence-write.ps1" },
      { "command": "powershell -ExecutionPolicy Bypass -File .cursor/hooks/control-database-write.ps1" },
      { "command": "powershell -ExecutionPolicy Bypass -File .cursor/hooks/block-bugreview-unapproved-jira.ps1" }
    ],
    "beforeShellExecution": [
      // { "command": "powershell -ExecutionPolicy Bypass -File .cursor/hooks/control-git-push.ps1" },
      { "command": "powershell -ExecutionPolicy Bypass -File .cursor/hooks/block-energots-branch-switch.ps1" },
      {
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/block-acli-rovo.ps1",
        "matcher": "acli|\\btwg\\b|teamwork-graph",
        "failClosed": true
      },
      {
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/block-elasticsearch-write.ps1",
        "matcher": "elastic|elasticsearch_mcp",
        "failClosed": false
      },
      {
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/block-postgresql-write.ps1",
        "matcher": "psql|mcp-postgres",
        "failClosed": false
      }
    ],
    "afterAgentResponse": [
      { "command": "powershell -ExecutionPolicy Bypass -File .cursor/hooks/validate-confidence-format.ps1" }
    ]
  }
}
