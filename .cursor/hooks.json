{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "python3 .cursor/hooks/cursor_adapter.py session-start", "timeout": 15 }
    ],
    "beforeSubmitPrompt": [
      { "command": "pwsh -NoProfile -File .cursor/hooks/block-jira-phoenix-delivery.ps1" },
      { "command": "pwsh -NoProfile -File .cursor/hooks/remind-test-case-env-first.ps1" },
      { "command": "pwsh -NoProfile -File .cursor/hooks/block-energots-branch-requests.ps1" }
    ],
    "afterFileEdit": [
      { "command": "pwsh -NoProfile -File .cursor/hooks/protect-phoenix-code.ps1" },
      { "command": "pwsh -NoProfile -File .cursor/hooks/protect-energots-writes.ps1" },
      { "command": "pwsh -NoProfile -File .cursor/hooks/warn-phoenix-code-edit.ps1" }
    ],
    "beforeMCPExecution": [
      { "command": "pwsh -NoProfile -File .cursor/hooks/block-confluence-write.ps1" },
      { "command": "pwsh -NoProfile -File .cursor/hooks/control-database-write.ps1" },
      { "command": "pwsh -NoProfile -File .cursor/hooks/block-bugreview-unapproved-jira.ps1" }
    ],
    "beforeShellExecution": [
      { "command": "pwsh -NoProfile -File .cursor/hooks/block-energots-branch-switch.ps1" },
      { "command": "python3 .cursor/hooks/cursor_adapter.py shell", "timeout": 90, "failClosed": true }
    ],
    "preToolUse": [
      { "command": "python3 .cursor/hooks/cursor_adapter.py tool", "matcher": "Shell|Write|Delete|Read|Grep", "timeout": 15, "failClosed": true }
    ],
    "postToolUse": [
      { "command": "python3 .cursor/hooks/cursor_adapter.py post-tool", "timeout": 10 }
    ],
    "postToolUseFailure": [
      { "command": "python3 .cursor/hooks/cursor_adapter.py tool-failure", "timeout": 10 }
    ],
    "preCompact": [
      { "command": "python3 .cursor/hooks/cursor_adapter.py pre-compact", "timeout": 10 }
    ],
    "subagentStart": [
      { "command": "python3 .cursor/hooks/cursor_adapter.py subagent-start", "timeout": 10 }
    ],
    "subagentStop": [
      { "command": "python3 .cursor/hooks/cursor_adapter.py subagent-stop", "timeout": 10 }
    ],
    "afterAgentResponse": [
      { "command": "pwsh -NoProfile -File .cursor/hooks/validate-confidence-format.ps1" }
    ]
  }
}
